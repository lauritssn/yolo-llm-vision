# =============================================================================
# RF-DETR Sidecar Configuration
# =============================================================================

# Instance segmentation model size: nano | small | medium | large
# nano is fastest and best for CPU; medium/large are more accurate but slower.
RFDETR_MODEL=nano

# Optional: load a custom fine-tuned checkpoint from MODELS_DIR (e.g. my-model.pth)
# RFDETR_CHECKPOINT=

# Directory for custom .pth checkpoints (Docker default: /models)
# MODELS_DIR=/models

# Default confidence threshold (0.0–1.0). The HA integration overrides this
# with its own setting (default 0.6) when calling /detect.
CONFIDENCE_THRESHOLD=0.5

# Port the sidecar listens on
PORT=8000
